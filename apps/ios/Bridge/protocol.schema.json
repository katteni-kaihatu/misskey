{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gridspace.invalid/ios-bridge/v1",
  "title": "GridSpace iOS bridge negotiation and public invalidation v1",
  "description": "Maximum serialized request: 4096 UTF-8 bytes. Only the selected HTTPS main frame and the owning WebView may send requests. accountEpoch is an opaque document/session nonce, not proof of an authenticated account. No authenticated or media-read operations are available.",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "requestId", "accountEpoch", "operation", "payload"],
  "properties": {
    "protocolVersion": {"const": 1},
    "requestId": {"type": "string", "format": "uuid"},
    "accountEpoch": {"type": ["string", "null"], "format": "uuid"},
    "operation": {"enum": ["capabilities", "ready", "session.changed"]},
    "payload": {"type": "object"}
  },
  "oneOf": [
    {
      "properties": {
        "operation": {"const": "capabilities"},
        "payload": {"type": "object", "maxProperties": 0}
      }
    },
    {
      "properties": {
        "operation": {"const": "ready"},
        "accountEpoch": {"type": "string", "format": "uuid"},
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schemaVersion", "webVersion"],
          "properties": {
            "schemaVersion": {"const": 1},
            "webVersion": {"type": "string", "minLength": 1, "maxLength": 128, "description": "Also limited to 128 UTF-8 bytes."}
          }
        }
      }
    },
    {
      "properties": {
        "operation": {"const": "session.changed"},
        "accountEpoch": {"type": "string", "format": "uuid"},
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["host", "userId", "reason"],
          "properties": {
            "host": {"type": "string", "minLength": 1, "maxLength": 300, "description": "Exact selected authority including a non-default port; also limited to 300 UTF-8 bytes."},
            "userId": {"type": ["string", "null"], "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_-]+$"},
            "reason": {"enum": ["boot", "switch", "logout", "revoked", "storage"]}
          }
        }
      }
    }
  ]
}
